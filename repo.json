   animation: none !important;\n  }\n  .splash, .rib, .brand {\n    opacity: 1;\n    visibility: visible;\n    transform: none;\n  }\n}\n</style>\n</head>\n\n<body>\n\n<div class=\"splash\">\n  <div class=\"ambient\"></div>\n  <div class=\"flash\"></div>\n\n  <svg class=\"logo\"\n       viewBox=\"0 0 1000 1000\"\n       xmlns=\"http://www.w3.org/2000/svg\">\n\n    <defs>\n      <linearGradient id=\"metal\"\n        x1=\"0%\" y1=\"0%\" x2=\"100%\" y2=\"100%\">\n        <stop offset=\"0%\" stop-color=\"#ffffff\"/>\n        <stop offset=\"45%\" stop-color=\"#ffffff\"/>\n        <stop offset=\"65%\" stop-color=\"#d7eaff\"/>\n        <stop offset=\"100%\" stop-color=\"#ffffff\"/>\n      </linearGradient>\n    </defs>\n\n    <path class=\"rib rib-left\"\n      fill=\"url(#metal)\"\n      d=\"M 315.7 196.1\n         L 443.1 196.1\n         L 486.3 272.5\n         L 637.3 56.9\n         L 486.3 317.6\n         L 427.5 219.6\n         L 352.9 219.6\n         L 437.3 382.4\n         L 254.9 694.1\n         L 415.7 382.4 Z\"/>\n\n    <path class=\"rib rib-right\"\n      fill=\"url(#metal)\"\n      d=\"M 745.1 56.9\n         L 576.5 396.1\n         L 674.5 574.5\n         L 535.3 574.5\n         L 500.0 502.0\n         L 358.8 698.0\n         L 502.0 454.9\n         L 552.9 547.1\n         L 635.3 547.1\n         L 547.1 396.1 Z\"/>\n  </svg>\n\n  <div class=\"brand\">XSIGN</div>\n</div>\n\n</body>\n</html>\n"
