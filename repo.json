      "custom_code": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\"\n      content=\"width=device-width, initial-scale=1.0\">\n<title>XSign | Premium Intro</title>\n\n<style>\n:root {\n  --duration: 3.5s;\n  --white: #ffffff;\n  --blue: #8ec5ff;\n}\n\n* {\n  box-sizing: border-box;\n}\n\nhtml, body {\n  width: 100%;\n  height: 100%;\n  margin: 0;\n  overflow: hidden;\n  background: #000;\n}\n\nbody {\n  display: grid;\n  place-items: center;\n  font-family: -apple-system, BlinkMacSystemFont,\n               \"SF Pro Display\", sans-serif;\n}\n\n.splash {\n  position: relative;\n  display: grid;\n  place-items: center;\n  width: 100%;\n  height: 100%;\n  isolation: isolate;\n  animation: sceneExit .45s 3.05s ease-in forwards;\n}\n\n/* Ambient light */\n.ambient {\n  position: absolute;\n  width: 340px;\n  height: 340px;\n  border-radius: 50%;\n  background: radial-gradient(circle,\n    rgba(60,130,255,.19) 0%,\n    rgba(35,80,180,.06) 42%,\n    transparent 70%);\n  filter: blur(28px);\n  opacity: 0;\n  animation: ambientIn 2.5s .4s ease-out forwards;\n}\n\n/* Logo container */\n.logo {\n  position: relative;\n  width: min(62vw, 270px);\n  aspect-ratio: 1;\n  overflow: visible;\n  filter: drop-shadow(0 0 0 transparent);\n  animation: logoGlow 3.5s ease-in-out forwards;\n}\n\n.rib {\n  fill: white;\n  opacity: 0;\n  transform-box: fill-box;\n  transform-origin: center;\n}\n\n.rib-left {\n  animation: leftEnter 3.5s\n             cubic-bezier(.16,1,.3,1) forwards;\n}\n\n.rib-right {\n  animation: rightEnter 3.5s\n             cubic-bezier(.16,1,.3,1) forwards;\n}\n\n/* Moving light across logo */\n.shine {\n  position: absolute;\n  inset: 0;\n  pointer-events: none;\n  overflow: hidden;\n  opacity: 0;\n  -webkit-mask-image: url(#unused);\n}\n\n.flash {\n  position: absolute;\n  width: 230px;\n  height: 230px;\n  border-radius: 50%;\n  background: radial-gradient(circle,\n    rgba(180,220,255,.24),\n    rgba(80,150,255,.08